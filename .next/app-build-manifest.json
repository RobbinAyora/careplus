      "static/chunks/app/(dashboard)/layout.js"
    ],
    "/(dashboard)/doctor/patients/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(dashboard)/doctor/patients/page.js"
    ],
    "/(dashboard)/doctor/appointments/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(dashboard)/doctor/appointments/page.js"
    ],
    "/(dashboard)/doctor/patients/[patientId]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(dashboard)/doctor/patients/[patientId]/page.js"
    ],
    "/_not-found/page": [
